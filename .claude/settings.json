{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm --filter:*)",
      "Bash(npx biome:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx sst diff:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "WebFetch(domain:sst.dev)",
      "WebFetch(domain:docs.expo.dev)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:biomejs.dev)",
      "WebFetch(domain:reactnative.dev)",
      "WebFetch(domain:tanstack.com)",
      "WebFetch(domain:zod.dev)"
    ],
    "deny": [
      "Bash(sst remove:*)",
      "Bash(npx sst remove:*)",
      "Bash(pnpm sst remove:*)",
      "Bash(pnpm dlx sst remove:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/biome-format.sh"
          }
        ]
      }
    ]
  }
}
