# Copy this file to `keystore.properties` (gitignored) and fill in real values,
# keeping the keystore file itself OUTSIDE the repo.
#
# `storeFile` must be an ABSOLUTE path to your upload keystore, e.g. one created with:
#   keytool -genkeypair -v -keystore ~/keys/techtok-upload.keystore \
#     -alias techtok -keyalg RSA -keysize 2048 -validity 10000
#
# android/app/build.gradle reads these for the `release` signingConfig; if
# keystore.properties is absent, release builds fall back to the debug key.

storeFile=/absolute/path/to/techtok-upload.keystore
storePassword=CHANGE_ME
keyAlias=techtok
keyPassword=CHANGE_ME
