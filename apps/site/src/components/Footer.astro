---
import type { Language } from '@techtok/shared';
import { AUTHOR_LINKEDIN_URL, GITHUB_REPO_URL } from '../lib/download';
import { localizedHref, withBase } from '../lib/locale';
import type { SiteStrings } from '../lib/copy';

interface Props {
  lang: Language;
  copy: SiteStrings;
}

const { lang, copy } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-row">
    <span>{copy.footer.tagline}</span>
    <nav class="footer-links">
      <a href={localizedHref(lang, 'test/')}>{copy.footer.tester}</a>
      <a href={withBase('privacy/')}>{copy.footer.privacy}</a>
      <a href={withBase('delete-account/')}>{copy.footer.deleteAccount}</a>
      <a href={GITHUB_REPO_URL} rel="noopener">{copy.footer.sourceCode}</a>
      <a href={AUTHOR_LINKEDIN_URL} rel="noopener">Andrii Kuznietsov</a>
      <span>© {year} · {copy.footer.license}</span>
    </nav>
  </div>
</footer>
