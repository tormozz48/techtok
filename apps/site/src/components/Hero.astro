---
import type { Language } from '@techtok/shared';
import type { SiteStrings } from '../lib/copy';
import { GITHUB_REPO_URL } from '../lib/download';
import { localizedHref } from '../lib/locale';
import HeroBackground from './HeroBackground.astro';
import ScreenshotCarousel from './ScreenshotCarousel.astro';

interface Props {
  lang: Language;
  copy: SiteStrings;
}

const { lang, copy } = Astro.props;
---

<section class="hero">
  <HeroBackground />
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-eyebrow">{copy.hero.eyebrow}</p>
      <h1>TechTok</h1>
      <p class="hero-tagline">{copy.hero.tagline}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={localizedHref(lang, 'test/')}>
          {copy.hero.ctaDownload}
        </a>
        <a class="button button-secondary" href={GITHUB_REPO_URL} rel="noopener">{copy.hero.ctaGithub}</a>
      </div>
    </div>
    <div class="hero-visual">
      <ScreenshotCarousel copy={copy} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
  }
</style>
