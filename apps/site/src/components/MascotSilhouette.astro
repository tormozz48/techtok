---
// Single-color silhouette of the "Buddy" mascot (D66): the same flat
// body/antenna/head geometry as OrbitMark.astro's inner mark, extracted here
// (un-scaled, in its own 200x220 coordinate space) so it can be recolored and
// reused at arbitrary sizes for the hero background's orbiting topic icons.
interface Props {
  size?: number;
  color?: string;
  class?: string;
}

const { size = 64, color = '#FF9F1C', class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size * 1.1}
  viewBox="0 0 200 220"
  xmlns="http://www.w3.org/2000/svg"
  role="presentation"
  aria-hidden="true"
>
  <path
    d="M 82 118 C 78 148, 72 178, 64 196 C 82 205, 118 205, 136 196 C 128 178, 122 148, 118 118 Z"
    fill={color}
  />
  <path d="M 82 55 C 68 40, 70 26, 60 14 L 66 10 C 78 22, 78 38, 92 52 Z" fill={color} />
  <circle cx="60" cy="10" r="9" fill={color} />
  <path d="M 118 55 C 132 40, 128 26, 138 14 L 132 10 C 122 22, 122 38, 108 52 Z" fill={color} />
  <circle cx="138" cy="10" r="9" fill={color} />
  <circle cx="100" cy="90" r="52" fill={color} />
  <circle cx="112" cy="90" r="20" fill="#ffffff" />
  <circle cx="116" cy="92" r="12" fill="#111A33" />
  <circle cx="116" cy="92" r="6" fill="#05070a" />
  <circle cx="120" cy="87" r="3" fill="#ffffff" />
</svg>
