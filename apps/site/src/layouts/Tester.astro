---
import type { Language } from '@techtok/shared';
import { SITE_COPY } from '../lib/copy';
import { PLAY_INVITE_PATH, TESTER_GROUP_URL } from '../lib/download';
import { SUPPORT_EMAIL } from '../lib/legal';
import { withBase } from '../lib/locale';
import { qrSvg } from '../lib/qr';
import Document from './Document.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const copy = SITE_COPY[lang].tester;
const siteOrigin = Astro.site ?? new URL(withBase(''), Astro.url).origin;
const inviteUrl = new URL(withBase(PLAY_INVITE_PATH), siteOrigin).href;
const qrCodes = [
  { href: TESTER_GROUP_URL, label: copy.ctaJoinGroup, svg: await qrSvg(TESTER_GROUP_URL), primary: true },
  { href: inviteUrl, label: copy.ctaOptIn, svg: await qrSvg(inviteUrl), primary: false },
];
---

<Document
  title={copy.title}
  description={copy.metaDescription}
  subpath={lang === 'en' ? 'test/' : `${lang}/test/`}
  lang={lang}
  switchPath="test/"
>
  <p>{copy.intro}</p>

  <h2>{copy.whyTitle}</h2>
  <p>{copy.whyBody}</p>

  <h2>{copy.askTitle}</h2>
  <ul>
    {copy.ask.map((item) => <li>{item}</li>)}
  </ul>

  <h2>{copy.stepsTitle}</h2>
  <ol class="steps">
    {
      copy.steps.map((step, index) => (
        <li>
          <span class="step-number">{index + 1}</span>
          <div>
            <strong>{step.title}</strong>
            <p>{step.body}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="tester-panel">
    <p class="tester-qr-hint">{copy.qrHint}</p>
    <div class="tester-qrs">
      {
        qrCodes.map((qr) => (
          <div class="tester-qr">
            <div class="qr-frame" set:html={qr.svg} />
            <a class:list={['button', qr.primary ? 'button-primary' : 'button-secondary']} href={qr.href} rel="noopener">
              {qr.label}
            </a>
          </div>
        ))
      }
    </div>
  </div>

  <h2>{copy.perksTitle}</h2>
  <p>{copy.perksBody}</p>

  <h2>{copy.feedbackTitle}</h2>
  <p>{copy.feedbackBody}</p>
  <p><a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></p>

  <div class="callout">
    <p><strong>{copy.privacyTitle}</strong> {copy.privacyBody}</p>
  </div>
</Document>

<style>
  .steps {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .steps li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    margin: 0;
  }

  .step-number {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    background: var(--chip-bg);
    color: var(--amber-soft);
    font-weight: 600;
    font-size: 0.875rem;
  }

  .steps li strong {
    display: block;
    color: var(--text);
    margin-bottom: 2px;
  }

  .steps li p {
    margin: 0;
  }

  .tester-panel {
    background: var(--navy-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    margin: 0 0 var(--space-5);
    text-align: center;
  }

  .tester-qr-hint {
    margin: 0 0 var(--space-4);
  }

  .tester-qrs {
    display: flex;
    justify-content: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .tester-qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }
</style>
