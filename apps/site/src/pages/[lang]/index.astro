---
import { LANGUAGES } from '@techtok/shared';
import type { Language } from '@techtok/shared';
import Landing from '../../layouts/Landing.astro';

export function getStaticPaths() {
  return LANGUAGES.filter((lang) => lang !== 'en').map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Exclude<Language, 'en'> };
---

<Landing lang={lang} />
