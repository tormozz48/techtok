{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!**/.sst",
      "!**/.expo",
      "!**/.astro",
      "!**/*.astro",
      "!apps/mobile/android",
      "!apps/mobile/ios",
      "!apps/mobile/assets",
      "!**/node_modules",
      "!**/sst-env.d.ts",
      "!apps/mobile/expo-env.d.ts",
      "!packages/shared/schema-snapshot.json",
      "!packages/core/drizzle"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
