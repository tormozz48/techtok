{
  "name": "techtok",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "lint": "biome check . && tsx scripts/checkNoComments.ts && tsx scripts/checkFileOrganization.ts",
    "lint:comments": "tsx scripts/checkNoComments.ts",
    "lint:organization": "tsx scripts/checkFileOrganization.ts",
    "lint:fix": "biome check --write .",
    "typecheck": "./scripts/typecheck-infra.sh && tsc --noEmit -p scripts/tsconfig.json && pnpm -r --if-present run typecheck",
    "test": "vitest run && pnpm --filter mobile run test",
    "dev": "sst dev --stage dev",
    "deploy:dev": "sst deploy --stage dev",
    "wipe-users": "tsx scripts/wipeUsers.ts",
    "grant-entitlement": "tsx scripts/grantEntitlement.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1090.0",
    "@aws-sdk/client-resource-groups-tagging-api": "3.1090.0",
    "@aws-sdk/lib-dynamodb": "3.1090.0",
    "@biomejs/biome": "2.5.4",
    "@techtok/core": "workspace:*",
    "@types/node": "22.20.1",
    "drizzle-kit": "^0.31.10",
    "sst": "4.17.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
